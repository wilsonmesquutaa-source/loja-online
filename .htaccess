Options -Indexes

RewriteEngine On


# ============================================================
# BLOQUEIA ARQUIVOS OCULTOS
# ============================================================

<FilesMatch "^\.">
    Require all denied
</FilesMatch>


# ============================================================
# BLOQUEIA ARQUIVOS INTERNOS
# ============================================================

<FilesMatch "(?i)^(composer\.(json|lock)|README\.md)$">
    Require all denied
</FilesMatch>


# ============================================================
# BLOQUEIA DIRETÓRIOS INTERNOS
# ============================================================

RewriteRule ^(?:\.git|\.idea|\.vscode)(?:/|$) - [F,L,NC]

RewriteRule ^(?:config|database|documentacao|routes|src|storage|vendor|views)(?:/|$) - [F,L,NC]


# ============================================================
# ASSETS PÚBLICOS
# ============================================================
#
# /loja-online/assets/css/navbar.css
#
# será servido de:
#
# /loja-online/public/assets/css/navbar.css
#

RewriteRule ^assets/(.*)$ public/assets/$1 [L]


# ============================================================
# ACESSO DIRETO À PASTA PUBLIC
# ============================================================
#
# Mantém /public funcionando durante a transição.
#

RewriteRule ^public(?:/|$) - [L]


# ============================================================
# FRONT CONTROLLER
# ============================================================
#
# Todas as demais requisições passam pelo:
#
# public/index.php
#

RewriteRule ^ public/index.php [L,QSA]